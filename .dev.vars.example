# Copy to .dev.vars (ignored by git) for local development with `npm run dev:api`

# Token for the template's /api/webhook (until the phase-1 webhooks replace it, docs/ROADMAP.md)
WEBHOOK_SECRET=dev-webhook-secret-12345

# Stands in for Cloudflare Access locally (ADR-007); never set in production
DEV_ACCESS_EMAIL=

# Pluggy, personal use via Meu Pluggy (ADR-008)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_WEBHOOK_SECRET=

# MacroDroid notifications: Authorization: Bearer <NOTIFICATION_WEBHOOK_SECRET>
NOTIFICATION_WEBHOOK_SECRET=

# Telegram bot for alerts and commands
TELEGRAM_BOT_TOKEN=

# Google Gemini (phase 2); the model name is configuration, not code
GEMINI_API_KEY=
GEMINI_MODEL=
