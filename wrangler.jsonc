// Cloudflare Worker: the app's files, the API, the webhooks and the cron (ADR-004, ADR-006).
// Secrets are not here: set them with `npx wrangler secret put <NAME>`, and locally in .dev.vars
// (see .dev.vars.example).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sinal-verde",
  "main": "server/entry/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/webhooks/*"]
  },
  // Normalized tables; migrations in migrations/, applied with `wrangler d1 migrations apply DB`.
  "d1_databases": [
    { "binding": "DB", "database_name": "sinal-verde", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  // Raw archive: every Pluggy response and webhook body, before normalization.
  "r2_buckets": [{ "binding": "RAW", "bucket_name": "sinal-verde-raw" }],
  // One cron for every time-based job; each job decides whether it is due (AppService.tick).
  "triggers": { "crons": ["*/5 * * * *"] },
  // Branch previews (ADR-004) get their own database and bucket, never production's.
  "previews": {
    "d1_databases": [
      { "binding": "DB", "database_name": "sinal-verde-preview", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
    ],
    "r2_buckets": [{ "binding": "RAW", "bucket_name": "sinal-verde-raw-preview" }]
  },
  "observability": { "enabled": true },
  "send_metrics": false
}
